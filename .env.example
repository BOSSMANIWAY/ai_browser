# Пример конфигурации LLM-провайдеров.
#
# Скопируйте в .env и заполните нужные значения:   cp .env.example .env
# Файл .env находится в .gitignore — НЕ КОММИТЬТЕ его: ключи, попавшие
# в публичную историю Git, отзывать придётся принудительно.
#
# Загружать переменные в окружение можно так:
#   set -a; source .env; set +a
#   python3 main.py --provider deepseek --task "..."
#
# Достаточно настроить ТОЛЬКО тот провайдер, которым пользуетесь.

# ─── Perplexity AI (провайдер по умолчанию, kind=pplx) ───────────────────────
# Официального API здесь нет — доступ через cookies авторизованной сессии
# (бесплатный ИИ через ваш аккаунт perplexity.ai).
#
# Формат файла — СТРОКА заголовка Cookie: "name=value; name2=value2" (не
# Netscape-экспорт расширений!). Нужны httpOnly-куки __Secure-1PSID /
# __Secure-1PSIDTS, которые отдаёт только DevTools браузера:
#   1. Войдите на https://www.perplexity.ai
#   2. F12 → вкладка Network → фильтр "perplexity_ask" → любой запрос
#   3. Request Headers → скопируйте значение заголовка Cookie целиком
#   4. Вставьте в .pplx_cookies.txt (в корне проекта) или в PPLX_COOKIES_FILE
# Полная инструкция: docs/PROVIDERS.md
PPLX_COOKIES_FILE=.pplx_cookies.txt
# id аккаунта из cookie `user` (заголовок x-pplx-account) — желателен.
PPLX_ACCOUNT_ID=
# Необязательно: идентификаторы запроса/сессии. По умолчанию — случайные UUID
# на каждый запуск, в переопределении обычно нет необходимости.
# PPLX_REQUEST_UUID=
# PPLX_RUM_SESSION_ID=
# PPLX_CONTEXT_UUID=

# ─── OpenAI-совместимые вендоры (kind=openai) ────────────────────────────────
# Для каждого: ключ + (опционально) <PROВАЙДЕР>_BASE_URL для смены эндпоинта.

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Kimi / Moonshot. По умолчанию используется китайский эндпоинт (.cn);
# для международного аккаунта раскомментируйте .ai:
KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1

DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# ─── Локальные серверы (ключ не требуется) ───────────────────────────────────
# Ollama: запустите `ollama serve` и подтяните модель `ollama pull qwen3:32b`
OLLAMA_BASE_URL=http://localhost:11434
# Для vision-агента подойдёт, например: ollama pull qwen3-vl:8b

# LM Studio: включите переключатель Server в приложении
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_API_KEY=            # нужен только если сервер защищён ключом

# LocalAI: docker run -p 8080:8080 localai/localai
LOCALAI_BASE_URL=http://localhost:8080/v1

# ─── Свой вендор без правки кода ─────────────────────────────────────────────
# Любой сервер с OpenAI-контрактом подключается записью в реестр
# (agent/providers.py) или вызовом register_provider — см. docs/PROVIDERS.md.
